# Contraseña del administrador para acceder a /create
ADMIN_PASSWORD=tu_contrasena_aqui

# Secreto para firmar la cookie de sesión (mínimo 32 caracteres aleatorios)
SESSION_SECRET=cambia_esto_por_32_caracteres_random

# Cloudinary — crear cuenta en https://cloudinary.com (free tier)
# Cloud name: en Settings > Account
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tu_cloud_name

# Upload preset: en Settings > Upload > Upload presets > Add upload preset (Unsigned)
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=tu_upload_preset

# URL pública de la app (opcional, para generar URLs absolutas en entornos sin window)
# En desarrollo se usa window.location.origin automáticamente
# NEXT_PUBLIC_APP_URL=https://tu-app.vercel.app
